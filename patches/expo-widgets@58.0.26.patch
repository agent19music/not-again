+/**
+ * Glance draws widget text with a system font family name. App-bundled faces such as
+ * Geist Mono are not visible to RemoteViews, so mono families map to the system monospace face.
+ */
+private fun String?.toGlanceFontFamily(): FontFamily? {
+  val name = this?.lowercase() ?: return null
+  return when {
+    name == "serif" -> FontFamily.Serif
+    name == "cursive" -> FontFamily.Cursive
+    name == "sansserif" || name == "sans-serif" || name == "default" -> FontFamily.SansSerif
+    name == "monospace" || name.contains("mono") || name.contains("geist") -> FontFamily.Monospace
+    else -> FontFamily(name)
+  }
+}
