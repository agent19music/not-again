{
  "expo": {
    "name": "Gooned",
    "slug": "Gooned",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gooned",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ufwsean.Gooned"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D82F46",
        "foregroundImage": "./assets/images/icon.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gooned"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D82F46",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
